# Modelo de configuração do Vigil SIEM.
# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NUNCA deve ser versionado (o .gitignore já o bloqueia).

# Nome exibido na documentação da API
VIGIL_APP_NAME=Vigil SIEM

# Ambiente de execução: development, testing ou production
VIGIL_ENVIRONMENT=development

# Modo de depuração. Mantenha false fora do desenvolvimento local
VIGIL_DEBUG=false